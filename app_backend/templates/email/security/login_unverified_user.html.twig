{% extends 'email/base.html.twig' %}

{% block title %}
    Vérification de votre adresse email
{% endblock %}

{% block header_title %}
    Vérification de votre adresse email
{% endblock %}

{% block content %}

    <div>
        <p>
            Bonjour {{ firstname }},
        </p>
        <p>
            Pas si vite !
        </p>
        <p>
            Avant de te laisser continuer, nous devons nous assurer qu'il s'agit bien de ton adresse email !
        </p>
        <p>
            Tout ce que tu as à faire c'est de cliquer sur le bouton ci dessous :
        </p>
        <div>
            <a href="{{url }}">
                Vérifier mon adresse email
            </a>
        </div>

    </div>

{% endblock %}

{% extends 'email/base.html.twig' %}

{% block title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block header_title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block content %}
    <div>
        <p>
            Bonjour {{ firstname }},
        </p>
        <p>
            Nous avons bien reçu ta demande de réinitialisation de mot de passe. Malheureusement il semblerais
            que tu n'as jamais activer ton compte.
        </p>
        <p>
            Pas de panique tout ce que tu as à faire c'est de cliquer sur le boutons suivant,
            puis de refaire une demande de réinitialisation :
        </p>
        <div>
            <a href="{{ url }}">
                Réinitialiser mon mot de passe
            </a>
        </div>
    </div>
{% endblock %}

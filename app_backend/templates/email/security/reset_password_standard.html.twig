{% extends 'email/base.html.twig' %}

{% block title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block header_title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block content %}
    <div>
        <p>
            Bonjour {{ firstname }},
        </p>
        <p>
            Nous avons bien reçu ta demande de réinitialisation de mot de passe.
        </p>
        {% include 'email/component/email_security_cta.html.twig' with {
            'url': url,
            'rawToken': rawToken,
            'buttonLabel': buttonLabel
        } %}
    </div>
{% endblock %}

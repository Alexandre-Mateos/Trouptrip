{% extends 'email/base.html.twig' %}

{% block title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block header_title %}
    Réinitialisation du mot de passe
{% endblock %}

{% block content %}
    <div>
        <p>
            Bonjour {{ firstname }},
        </p>
        <p>
            Nous avons bien reçu ta demande de réinitialisation de mot de passe.
        </p>
        <p>
            Tous ce que tu as à faire c'est cliquer sur le bouton suivant et te laisser guider :
        </p>
        <div>
            <a href="{{ url }}">
                Réinitialiser mon mot de passe
            </a>
        </div>
    </div>
{% endblock %}

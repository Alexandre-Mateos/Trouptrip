<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}
        {% endblock %}
    </title>

    <style>
        body {
            margin: 0;
        }

        .wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .container {
            display: flex;
            flex-direction: column;
            width: 100%;
            padding: 2rem;
            box-sizing: border-box;
            gap: 2rem;
        }

        .header {
            display: flex;
            width: 100%;
        }

        .content {
            display: flex;
            flex-direction: column;
            width: 100%;
            gap: 1rem;
        }

        .footer {
            display: flex;
            width: 100%;
        }
    </style>
</head>

<body>

<div class="wrapper">

    <div class="container">
        <header class="header">
            <h1>
                {% block email_title %}
                    Notification
                {% endblock %}
            </h1>
        </header>

        <main class="content">
            {% block content %}{% endblock %}
        </main>

        <footer class="footer">
            <p>
                Cet email est généré automatiquement, merci de ne pas y répondre.
            </p>
        </footer>
    </div>

</div>

</body>
</html>
